# ==============================================================================
# BUENOS DÍAS — VARIABLES DE ENTORNO (TEMPLATE DE EJEMPLO)
# Copiá este archivo como `.env` y completá tus credenciales y configuración.
# ==============================================================================

# --- Personalización de Usuario ---
# Tu nombre o apodo para saludos y síntesis de IA
USER_NAME=Moshi
# Tu ciudad y región (para contextualizar pronósticos y respuestas)
USER_CITY=Concordia, Entre Ríos, Argentina

# --- Clima (Open-Meteo, gratis y sin API key) ---
# Coordenadas geográficas de tu ciudad (ej: Concordia, Entre Ríos, Argentina)
WEATHER_LAT=-31.3928
WEATHER_LON=-58.0209

# --- Motor de IA Principal: Groq (LPU Ultra-rápido y gratuito) ---
# Obtené tu clave gratuita en: https://console.groq.com/keys
GROQ_API_KEY=gsk_tu_clave_aqui
# Modelos recomendados: openai/gpt-oss-120b, qwen/qwen3.8-27b
GROQ_MODEL=openai/gpt-oss-120b

# --- Motor de IA Secundario / Fallback: Google Gemini (Opcional) ---
# Obtené tu clave gratuita en: https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# --- Notificaciones Ejecutivas de WhatsApp (Opcional) ---
# Tu número telefónico en formato internacional sin espacios ni "+" (ej: 5493451234567)
# Si lo dejás vacío, el reporte solo se abrirá en el Dashboard Web y la notificación de Windows.
WHATSAPP_TO_NUMBER=

# --- Sincronización de Hábitos con Google Sheets (Opcional) ---
# URL de la Web App de Google Apps Script para guardar tu check-in matutino diario.
# Consultá la guía completa en: docs/google-sheets-setup.md
GOOGLE_SHEETS_WEBHOOK_URL=
